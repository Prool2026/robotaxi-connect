# Use ONLY a NEW Robotaxi Supabase project. Never copy PAN-Viewer environment files.
ROBOTAXI_SUPABASE_URL=
ROBOTAXI_SUPABASE_PUBLISHABLE_KEY=
# Must match the NEW project URL subdomain; an additional deployment safety check.
ROBOTAXI_SUPABASE_PROJECT_REF=
# Only the email worker, development seed and integration tests need this secret.
ROBOTAXI_SUPABASE_SECRET_KEY=
ROBOTAXI_APP_URL=http://localhost:3100
ROBOTAXI_BRAND_NAME=Robotaxi Connect
ROBOTAXI_LEGAL_NAME=
ROBOTAXI_SUPPORT_EMAIL=
ROBOTAXI_BRAND_DOMAIN=
ROBOTAXI_LOGO=/robotaxi-logo.png
ROBOTAXI_EMAIL_FROM=
ROBOTAXI_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Set only after replacing and reviewing all legal placeholders.
ROBOTAXI_LEGAL_READY=false
# Development only. No production fallback or automatic demo seeding.
ROBOTAXI_DEMO=false
ROBOTAXI_ALLOW_DEMO_SEED=false
ROBOTAXI_DEMO_PASSWORD=
# Integration tests against a disposable LOCAL Supabase instance only.
ROBOTAXI_TEST_DATABASE=false
